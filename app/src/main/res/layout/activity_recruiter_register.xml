<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_white_cream_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="Customer Registration 🧑‍💼"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/recruiter_name"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Full Name"
            android:inputType="text"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="14dp"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/recruiter_email"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/recruiter_password"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/recruiter_number"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Mobile Number"
            android:inputType="phone"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/recruiterRegisterBtn"
            android:text="Register As Customer"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@android:color/black"
            app:cornerRadius="10dp"
            android:elevation="6dp"/>

        <FrameLayout
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="22dp"
            android:elevation="8dp"
            android:padding="12dp"
            >
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/skill_link_logo"
                android:scaleType="centerCrop"
                android:contentDescription="SkillLink Logo"
                android:clipToOutline="true"
                />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
