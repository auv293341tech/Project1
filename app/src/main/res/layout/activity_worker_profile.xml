<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/ivWorkerProfile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_light"
            android:src="@drawable/ic_account"
            android:padding="16dp" />

        <!-- Name -->
        <TextView
            android:id="@+id/tvWorkerName"
            android:text="Worker Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:textColor="#0F172A"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"/>

        <!-- Skill -->
        <TextView
            android:id="@+id/tvWorkerSkill"
            android:text="Electrician"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"/>

        <!-- Rating -->
        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:isIndicator="true"
            style="?android:attr/ratingBarStyleSmall"/>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnContact"
                android:text="Contact"
                android:textAllCaps="false"
                android:background="@drawable/bg_outline_button"
                android:textColor="@color/blue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHire"
                android:text="Assign"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_primary_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"/>
        </LinearLayout>

        <!-- Reviews -->
        <TextView
            android:text="Reviews"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="28dp"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
