<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_white_cream_gradient"
    >


    <!-- Title -->
    <!-- LOGO Circle -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="22dp"
        android:elevation="8dp"
        android:padding="12dp"
>
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/skill_link_logo"
            android:scaleType="centerCrop"
            android:contentDescription="SkillLink Logo"
            android:clipToOutline="true"
            />
    </FrameLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back 👋"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login to continue using SkillLink"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp" />


    <!-- Email -->
    <EditText
        android:id="@+id/email"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:padding="14dp"
        android:textSize="16sp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:background="@drawable/bg_input"
        android:layout_marginBottom="14dp" />

    <!-- Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:passwordToggleEnabled="true"
        app:hintEnabled="false"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Forgot Password -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot password?"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true" />


    <!-- Login Button -->
    <Button
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Login"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@android:color/black"
        app:cornerRadius="10dp"
        android:elevation="6dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp" />

    <!-- New user -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New user? Create an account"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp" />

    <!-- Register Button -->
    <Button
        android:id="@+id/registerBtn"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Register"
        android:textAllCaps="false"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:strokeColor="@android:color/black" />

</LinearLayout>