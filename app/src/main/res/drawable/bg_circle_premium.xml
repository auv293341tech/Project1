<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#E5E7EB">

    <item>
        <shape android:shape="oval">

            <!-- 🎨 Gradient Background -->
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#F1F5F9"
                android:angle="270"/>

            <!-- 🖤 Border -->
            <stroke
                android:width="1dp"
                android:color="#CBD5E1"/>

            <!-- 🟢 Circle Shape -->
            <size
                android:width="52dp"
                android:height="52dp"/>
        </shape>
    </item>

</ripple>
